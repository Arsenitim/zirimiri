PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/zirimiri.sqlite
# Public viewer fallback; requires no credentials. See docs/data-source.md.
SOURCE=viewer
# Minimum 20 minutes; sequential requests with >=250 ms between requests.
POLL_MINUTES=30
REQUEST_DELAY_MS=350
RETENTION_DAYS=18
# Set false to inspect an existing cache without background source requests.
INGEST_ON_START=true
# Optional subset for a quick start, e.g. C029,C072. Empty = full inventory.
STATION_IDS=
# Documented API transport is available for investigation; adapter defaults to verified viewer format.
EUSKALMET_PRIVATE_KEY_PATH=
EUSKALMET_EMAIL=
EUSKALMET_LOGIN_ID=
EUSKALMET_ISSUER=zirimiri
# OSM standard tiles are for modest interactive use, not bulk downloads/offline maps.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
